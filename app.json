{
  "expo": {
    "name": "Day Rise",
    "slug": "day-rise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "day-rise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yooinhak.dayrise",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Day Rise는 더 나은 서비스 제공을 위해 사용 데이터를 수집할 수 있습니다.",
        "CFBundleLocalizations": ["ko"],
        "CFBundleDevelopmentRegion": "ko"
      },
      "appleTeamId": "ARPM23GNDZ",
      "usesAppleSignIn": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FBF6F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yooinhak.dayrise",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      ["expo-notifications", { "sounds": [], "mode": "development" }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "yooinhak",
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
